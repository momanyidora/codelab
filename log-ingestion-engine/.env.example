# Server
PORT=4000
ENV=production

# Rate Limiting 
RATE_LIMIT=1000

# Channel 
RAW_LOG_BUFFER=10000
CONSUMER_BATCH_SIZE=50

# RabbitMQ 
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# SQLite 
SQLITE_BATCH_SIZE=100
SQLITE_BATCH_INTERVAL=1000

# Alerts 
ERROR_RATE_THRESHOLD=10
QUEUE_BACKLOG_THRESHOLD=5000
DEAD_LETTER_THRESHOLD=1000